# Copy to /root/workspace/automation/sub2api-upstream-sync/config.env if needed.
SUB2API_REPO_DIR=/root/workspace/sub2api
SUB2API_ORIGIN_REMOTE=origin
SUB2API_PRIMARY_REMOTE=upstream
SUB2API_PRIMARY_BRANCH=main
SUB2API_SECOND_REMOTE=overdraft
SUB2API_SECOND_BRANCH=sub2api-custom
SUB2API_TARGET_BRANCH=main
SUB2API_VALIDATE=true
SUB2API_DRY_RUN=false
SUB2API_VALIDATION_REPAIR_ATTEMPTS=3
SUB2API_RELEASE_ENABLED=true
SUB2API_RELEASE_MIN_UPSTREAM_COMMITS=3
SUB2API_RELEASE_MIN_CHANGED_FILES=8
SUB2API_RELEASE_MIN_DIFF_LINES=150
SUB2API_RELEASE_REQUIRE_NO_RISKS=true
SUB2API_GO_IMAGE=golang:1.27.0
SUB2API_COREPACK_BIN=/usr/bin/corepack
SUB2API_PNPM_VERSION=9.15.9

# Reuse the SMTP configuration already stored by the local new-api service.
EMAIL_ENABLED=true
EMAIL_TO=2475528229@qq.com
SMTP_CONFIG_SOURCE=new_api_postgres
SMTP_POSTGRES_CONTAINER=postgres
SMTP_DB_USER=root
SMTP_DB_NAME=new-api
