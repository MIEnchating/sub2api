{
  "features": [
    {
      "name": "共享账号池",
      "path_pattern": "(^|/)[^/]*(?:shared[_-]?account|shared[_-]?pool|shared[_-]?api[_-]?key|shared[_-]?listing|shared_proxy_credentials|add-shared-account-pool)",
      "content_pattern": "shared[_-]?account[_-]?(?:pool|listing|wallet|usage|revenue|fee|freeze)|shared[_-]pool(?:[_-](?:enabled|fee|api|account|listing|wallet|usage|revenue|freeze))|SharedPool(?:Enabled|Fee|Handler|Service)|shared[_-]?(?:total[_-]?call[_-]?count|listing[_-]?status)|shared[_-]?api[_-]?key|is_shared_pool|(?<![A-Za-z0-9_])account_scope(?![A-Za-z0-9_])",
      "content_roots": [
        "frontend/src/",
        "backend/internal/",
        "backend/cmd/",
        "backend/ent/",
        "backend/migrations/",
        "deploy/"
      ]
    },
    {
      "name": "fork 生图计费扩展",
      "path_pattern": "^(?:backend/internal/(?:handler/image_billing_response|service/image_usage_billing)(?:_test)?[.]go|frontend/src/i18n/locales/(?:en|zh)/imageUsage[.]ts)$",
      "content_pattern": "\\b(?:image_minimum_charge(?:_adjustment)?|ImageMinimumCharge(?:Adjustment)?|ImageBillingReceipt|ImageEquivalentOutputPricePerMillion|image_purchase_prices|ImagePurchasePrices(?:Key)?|OpenAIImageResponseHeaderTimeout|image_group_ids|openaiImageHeaderTimeoutGroups)\\b",
      "content_roots": [
        "backend/internal/",
        "frontend/src/"
      ]
    },
    {
      "name": "批量生图",
      "path_pattern": "(^|/)(?:batch[_-]?image|useBatchImage|\\d+_.*batch_image)",
      "content_pattern": "batch[_-]?image|/images/batches|/key-image-batches|批量生图|批量图片生成",
      "content_roots": [
        "frontend/src/",
        "backend/internal/",
        "backend/cmd/",
        "backend/ent/",
        "backend/migrations/",
        "deploy/"
      ],
      "preserved_paths": [
        "backend/internal/repository/migrations_runner.go",
        "backend/migrations/159_batch_image_foundation.sql",
        "backend/migrations/160_batch_image_provider_refs.sql",
        "backend/migrations/161_batch_image_pricing_snapshot.sql",
        "backend/migrations/162_add_group_batch_image_generation_gate.sql",
        "backend/migrations/163_batch_image_default_discount_and_hold_ratio.sql",
        "backend/migrations/164_batch_image_download_and_user_delete.sql",
        "backend/migrations/165_hide_pre_upstream_batch_image_failures.sql",
        "backend/migrations/166_batch_image_task_name.sql",
        "backend/migrations/167_clear_auto_batch_image_task_names.sql",
        "backend/migrations/168_restore_empty_batch_image_task_names.sql",
        "backend/migrations/169_batch_image_parent_batch.sql",
        "backend/migrations/187_add_usage_log_session_id.sql",
        "backend/migrations/234_batch_image_routed_group.sql"
      ]
    }
  ],
  "fork_image_generation": {
    "name": "fork 生图二开",
    "path_pattern": "(^|/)(?:backend/internal/qqbot/(?:chat_image_tool|image_edit|image_intent|image_output|image_progress|setup_image)[^/]*\\.go|backend/internal/handler/(?:image_task_error_message|moderation_upstream_images)_test[.]go|backend/internal/service/(?:openai_excel_bps_images|openai_images_allowlist|openai_images_(?:form_compat|billing_error)_test|openai_image_routing|image_intent_prefilter_test|image_task_error_message_test)[^/]*\\.go|frontend/src/components/(?:admin/qqbot/QQBotImageAISettings|account/ExtraImageModelsField)\\.vue)$",
    "content_pattern": "json:\"(?:image_enabled|image_ai_connection|image_site_api_key_id|image_daily_limit)\"|\\bimage_generate\\b|/images/(?:generations|edits)",
    "content_roots": [
      "backend/internal/qqbot/"
    ]
  }
}
